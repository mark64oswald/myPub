# myPub .gitignore

# Database files (contain indexed data, can be regenerated)
data/*.ddb
data/*.db
data/*.duckdb
data/*.wal

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs — keep the .gitkeep stub and any phase-run markdown reports, but
# ignore ephemeral *.log files. Phase deliverables (per execution plan)
# like extraction_run_*.md land here and should be tracked.
*.log
logs/*
!logs/.gitkeep
!logs/*.md

# Temporary files
tmp/
temp/
*.tmp

# Generated skills (optional - may want to track some)
# skills/generated/

# Test output
tests/output/
.coverage
htmlcov/

# Environment
.env
.env.local

# ePub files (source of truth is ~/Documents/ebooks)
*.epub

# Large exports
exports/
data/extraction-sessions/
data/extraction-runs/
data/alignment-runs/
data/dedupe-runs/
data/skill-runs/
data/generated-packages/
